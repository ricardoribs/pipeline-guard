{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipeline-guard:contracts:remediation_result_v1.schema.json",
  "title": "remediation_result_v1",
  "description": "Terminal result of a remediation execution; it never includes merge or deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "incident_id", "status", "base_commit"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "incident_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["DRAFT_PR_PUBLISHED", "BLOCKED_VALIDATION_FAILED", "BLOCKED_APPROVAL_INVALID", "BLOCKED_LIMIT_EXCEEDED", "ERROR"] },
    "reason": { "type": "string" },
    "base_commit": { "type": "string", "minLength": 1 },
    "branch": { "type": "string" },
    "commit": { "type": "string" },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "lines_added": { "type": "integer", "minimum": 0 },
          "lines_removed": { "type": "integer", "minimum": 0 }
        }
      },
      "default": []
    },
    "patch_hash": { "type": "string", "description": "SHA-256 hash of the applied patch." },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["PASSED", "FAILED", "TIMEOUT", "SKIPPED"] },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "log_reference": { "type": "string" }
        }
      },
      "default": []
    },
    "draft_pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "pr_validation_status": {
      "type": "string",
      "enum": ["VALIDATED", "PUBLISHED_UNVALIDATED"],
      "description": "Distinguishes a published draft pull request whose declared validation commands all passed (VALIDATED) from one published despite missing or failed tests under the project's explicit unvalidated-PR policy (PUBLISHED_UNVALIDATED). Determined by the GitProvider from the Test Executor's aggregate status, never by the Test Executor itself."
    },
    "limitations": { "type": "array", "items": { "type": "string" }, "default": [] },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "log_references": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "if": { "properties": { "status": { "const": "DRAFT_PR_PUBLISHED" } } },
  "then": {
    "required": ["branch", "commit", "patch_hash", "tests", "draft_pr", "pr_validation_status"],
    "properties": {
      "tests": { "type": "array", "minItems": 1 }
    }
  }
}
