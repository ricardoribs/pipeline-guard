{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipeline-guard:credential-reference.schema.json",
  "title": "Credential reference",
  "description": "A credential reference, never a literal credential value.",
  "type": "string",
  "oneOf": [
    { "pattern": "^[A-Z][A-Z0-9_]*$" },
    { "pattern": "^env:[A-Z][A-Z0-9_]*$" },
    { "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$" },
    { "pattern": "^secret:[A-Za-z0-9][A-Za-z0-9._/-]*$" }
  ]
}
