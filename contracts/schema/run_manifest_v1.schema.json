{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipeline-guard:contracts:run_manifest_v1.schema.json",
  "title": "run_manifest_v1",
  "description": "Internal terminal record of one pipeline-guard diagnosis execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "incident_id",
    "status",
    "created_at",
    "started_at",
    "finished_at",
    "duration_seconds",
    "contract_versions",
    "evidence_hashes",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "incident_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED", "STOPPED_UNKNOWN"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "contract_versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "evidence_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "hash"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
